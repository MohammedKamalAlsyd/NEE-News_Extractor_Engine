{
    "name": "NEE-News Extractor Engine",
    "version": "0.0.1",
    "type": "module",
    "description": "A Node.js package for scraping and extracting news articles from popular domains. Discover news websites, extract articles and their metadata.",
    "main": "dist/main.js",
    "module": "dist/main.mjs",
    "types": "dist/main.d.ts",
    "dependencies": {
        "cheerio": "^1.0.0",
        "crawlee": "^3.0.0",
        "date-fns": "^4.1.0",
        "domhandler": "^5.0.3",
        "playwright": "*"
    },
    "devDependencies": {
        "@apify/tsconfig": "^0.1.0",
        "@types/node": "^22.0.0",
        "tsx": "^4.4.0",
        "typescript": "~5.8.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "test": "echo \"Error: oops, the actor has no tests yet, sad!\" && exit 1",
        "postinstall": "npx crawlee install-playwright-browsers"
    },
    "author": "Mohammed Kamal Alsyd",
    "license": "MIT",
    "keywords": [
        "news",
        "scraping",
        "web scraping",
        "article extraction",
        "news aggregation",
        "crawler",
        "headless browser",
        "Playwright",
        "Cheerio",
        "SEO",
        "data extraction"
    ]
}
