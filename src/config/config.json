{
  "timeout": 45000,
  "workerNodes": 5,
  "logRetentionDays": 3,
  "enableLogging": true,
  "targetLanguage": "auto",
  "searchEngine": "bing",
  "crawleeConfig": {
    "persistStateIntervalMillis": 10000,
    "CRAWLEE_MEMORY_MBYTES": 8192,
    "storageClientOptions": {
      "localDataDirectory": "./storage",
      "localStorage": "gwir"
    }
  },
  "proxyConfig": {
    "enabled": false,
    "apiUrl": "http://username:password@your-proxy-provider.com:port"
  },
  "searchEnginePages": 10,
  "articlesPerDomain": 50,
  "pagesToCrawlPerDomain": 10
}
